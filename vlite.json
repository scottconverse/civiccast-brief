{
  "version": 1,
  "base": "origin/main",
  "docs": [
    "**/*.md",
    "**/*.mdx",
    "**/*.rst",
    "**/*.docx",
    "**/*.pdf",
    "LICENSE*",
    "NOTICE*",
    "docs/**",
    "website/**"
  ],
  "codeDespiteDocs": [
    "**/SKILL.md",
    "report-local-news/**",
    ".claude/**",
    "**/.claude/**",
    "CLAUDE.md",
    "**/AGENTS.md",
    "tests/**/fixtures/**"
  ],
  "parts": [
    {
      "name": "python",
      "paths": [
        "src/**/*.py",
        "tests/**/*.py",
        "pyproject.toml",
        "uv.lock"
      ],
      "cwd": ".",
      "checks": [
        {
          "name": "lint",
          "run": "uv run --no-sync ruff check && uv run --no-sync ruff format --check",
          "timeoutSec": 120
        }
      ]
    },
    {
      "name": "core",
      "paths": [
        "src/civiccast_brief/*.py",
        "tests/*.py"
      ],
      "cwd": ".",
      "checks": [
        {
          "name": "tests",
          "run": "uv run --no-sync pytest tests --ignore-glob=tests/*/* -m \"not integration\" -q -x -p no:cacheprovider",
          "timeoutSec": 600
        }
      ]
    },
    {
      "name": "module:{name}",
      "paths": [
        "src/civiccast_brief/{name}/**",
        "tests/{name}/**"
      ],
      "requires": [
        "tests/{name}"
      ],
      "cwd": ".",
      "checks": [
        {
          "name": "tests",
          "run": "uv run --no-sync pytest tests/{name} -m \"not integration\" -q -x -p no:cacheprovider",
          "timeoutSec": 900
        }
      ]
    },
    {
      "name": "signup-worker",
      "paths": [
        "worker/signup/**"
      ],
      "requires": [
        "worker/signup/node_modules"
      ],
      "cwd": "worker/signup",
      "checks": [
        {
          "name": "typecheck",
          "run": "npm run typecheck",
          "timeoutSec": 300
        },
        {
          "name": "tests",
          "run": "npm test",
          "timeoutSec": 600
        }
      ]
    }
  ],
  "tests": {
    "paths": [
      "tests/**",
      "worker/signup/test/**"
    ],
    "removalsLog": "TEST-REMOVALS.md"
  },
  "maxRounds": 3,
  "gate": {
    "mode": "observe"
  }
}
